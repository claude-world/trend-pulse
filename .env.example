# trend-pulse optional settings. Every value is optional; sources and features
# that need a missing credential are skipped gracefully.

# Hybrid scoring L2 judge (Claude API)
ANTHROPIC_API_KEY=

# youtube_trending: YouTube Data API v3 key (YouTube retired its keyless Trending page)
YOUTUBE_API_KEY=

# x_trending: guest-API fallback when twikit cannot fetch trends
X_BEARER_TOKEN=

# render_page tool: Cloudflare Browser Rendering
CF_ACCOUNT_ID=
CF_API_TOKEN=

# send_notification tool
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
# LINE_NOTIFY_TOKEN: LINE Notify was shut down on 2025-03-31

# SQLite history location (default: ~/.trend-pulse/history.db)
# TREND_PULSE_DB=
